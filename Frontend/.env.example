# =============================================================================
# REDHILL INVESTOR PORTAL - FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API & BACKEND CONNECTION
# -----------------------------------------------------------------------------
# In Local Development:
# Leave VITE_API_BASE_URL empty to use Vite's built-in dev proxy (/api -> http://localhost:5001)
# Or set to http://localhost:5001 if calling backend directly.
#
# In Production on Render (Static Site):
# Set this to your live Render Backend URL (e.g., https://redhill-portal-api.onrender.com)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# 2. ASSETS / MEDIA URL
# -----------------------------------------------------------------------------
# Base URL for uploaded images and documents.
# Defaults to VITE_API_BASE_URL if left empty.
VITE_ASSETS_BASE_URL=

# -----------------------------------------------------------------------------
# 3. APPLICATION BRANDING
# -----------------------------------------------------------------------------
VITE_APP_NAME="Redhill Infrastructure Investor Portal"

# -----------------------------------------------------------------------------
# 4. LOCAL DEV PROXY CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# Target URL for Vite dev proxy when running `npm run dev`
VITE_PROXY_TARGET=http://localhost:5001
