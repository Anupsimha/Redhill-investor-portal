# =============================================================================
# REDHILL INVESTOR PORTAL - BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# The port the backend server listens on (Render automatically provides PORT in production)
PORT=5001

# The host interface to bind to ('0.0.0.0' is required for Render / Docker)
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 2. CORS & FRONTEND URL CONFIGURATION
# -----------------------------------------------------------------------------
# The public URL of the Frontend (used for email links & redirects)
# In production on Render, set this to your frontend URL (e.g. https://redhill-portal.onrender.com)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins for cookie credentials
# E.g. http://localhost:5173,http://localhost:3001,https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Secret key used to sign JWT tokens. MUST be changed in production!
JWT_SECRET=redhill-infra-super-secure-jwt-secret-key-change-in-production

# JWT token expiration time (e.g., '24h', '7d')
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# 4. STORAGE & DATABASE (Persistent Disks on Render)
# -----------------------------------------------------------------------------
# Path to SQLite database file.
# In local dev: database.sqlite
# On Render with Persistent Disk: /var/data/database.sqlite
DATABASE_PATH=database.sqlite

# Directory where uploaded images & documents are stored.
# In local dev: uploads
# On Render with Persistent Disk: /var/data/uploads
UPLOADS_DIR=uploads

# -----------------------------------------------------------------------------
# 5. EMAIL DISPATCH (Optional - Choose Gmail App Password or SendGrid or Custom SMTP)
# -----------------------------------------------------------------------------
# --- OPTION 1: GMAIL / SMTP (Recommended for real Gmail delivery) ---
# 1. Go to your Google Account -> Security -> 2-Step Verification (turn ON)
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password (Name: "Redhill Portal") -> Copy the 16-character password
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_EMAIL=noreply@redhillinfra.com

# --- OPTION 2: SENDGRID ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# --- OPTION 3: CUSTOM SMTP ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=465
# SMTP_SECURE=true
